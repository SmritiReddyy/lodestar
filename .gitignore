# --- data -----------------------------------------------------------------
# Generated source CSVs, the landing zone and the DuckDB warehouse are all
# reproducible from `make setup`. Committing them would add ~130 MB of noise.
data/
*.duckdb
*.duckdb.wal

# --- dbt ------------------------------------------------------------------
dbt_project/target/
dbt_project/dbt_packages/
dbt_project/logs/
.user.yml

# --- data quality ---------------------------------------------------------
quality/results/
gx/
uncommitted/

# --- airflow --------------------------------------------------------------
airflow/logs/
airflow/plugins/__pycache__/
airflow-webserver.pid
standalone_admin_password.txt

# --- terraform ------------------------------------------------------------
# Never commit state: it holds resource ids and can hold secrets.
.terraform/
.terraform.lock.hcl
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
crash.log
override.tf
override.tf.json

# --- python ---------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# --- credentials ----------------------------------------------------------
.env
.env.*
!.env.example
*-service-account.json
credentials.json
gcp-key.json

# --- editors / os ---------------------------------------------------------
.DS_Store
.idea/
.vscode/
*.swp
